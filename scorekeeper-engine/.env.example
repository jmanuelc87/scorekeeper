# Must name an async driver (postgresql+asyncpg). asyncpg ignores libpq query params,
# so "?sslmode=require" does nothing — TLS is configured in code via connect_args.
DATABASE_URL=postgresql+asyncpg://scorekeeper:scorekeeper@localhost:5432/scorekeeper
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Root log level for the structlog JSON output (single stream on stdout).
LOG_LEVEL=INFO
# Celery broker for the evaluation worker. Defaults to the app's Postgres via
# kombu's SQLAlchemy transport, which is sync-only: DATABASE_URL with its async driver
# swapped back to postgresql+psycopg and prefixed "sqla+". Override to use e.g. Redis.
# CELERY_BROKER_URL=
# LLM-as-a-judge (requires `uv sync --extra judges`)
JUDGE_PROVIDER=agent  # anthropic | openai | agent
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_JUDGE_MODEL=claude-opus-4-8
OPENAI_JUDGE_MODEL=gpt-5.6-sol
# OpenAI-compatible endpoint for chat and embeddings (e.g. http://localhost:1234/v1 for
# LM Studio). Blank = https://api.openai.com/v1. With JUDGE_PROVIDER=agent this points
# answer_relevance's embeddings at a local server; OPENAI_API_KEY must still be non-empty
# (local servers ignore its value). Note the chat side still validates model ids against
# the OpenAI allow-list, so a local *judging* model is not supported.
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JUDGE_MAX_TOKENS=16384
JUDGE_TIMEOUT_SECONDS=900
# Claude Agent SDK judge (JUDGE_PROVIDER=agent): runs through the Claude Code CLI
# bundled with claude-agent-sdk and authenticates with the local Claude Code session,
# so no API key is needed. Must name a Claude model the judge knows. For
# answer_relevance, embeddings still need OPENAI_API_KEY (see OPENAI_BASE_URL above to
# keep them on a local server).
AGENT_JUDGE_MODEL=claude-opus-4-8
# Claude Code OAuth token (generate one with `claude setup-token`). Required in Docker:
# the container has no Claude Code session and no ~/.claude credentials, so without it
# the `agent` judge cannot authenticate. Leave blank when running locally to keep using
# the existing session.
CLAUDE_CODE_OAUTH_TOKEN=
# Override the judge system prompt (leave blank to use the built-in Spanish default)
JUDGE_SYSTEM_PROMPT=
# Trace every LLM API call the judge makes (op, model, step, turn, sizes, latency,
# outcome) to the "scorekeeper.metrics.judges.tracing" logger. Observational only.
JUDGE_TRACE_ENABLED=false
# Local directory for the retrieval fetch cache (scorekeeper.retrieval.fetch); fetched
# document bytes are stored here so each document is downloaded at most once per platform
# execution, then deleted when that execution's retrieval finishes.
RETRIEVAL_CACHE_DIR=./retrieval-cache
# Retrieval credential store (scorekeeper.retrieval.credentials). Master secret used to
# encrypt/decrypt certificate private keys stored per provider in the auth_providers
# table. Leave blank to disable cert-based providers (gated docs → MISSING_CREDENTIALS).
# Requires `uv sync --extra retrieval` for the SharePoint (office365) provider.
AUTH_ENCRYPTION_KEY=dummy-auth-encryption-key
# Random pause (seconds) between scoring consecutive turns, to pace judge calls.
# Each pause is drawn uniformly from [MIN, MAX]; set both to 0 to disable.
TURN_DELAY_MIN_SECONDS=1.0
TURN_DELAY_MAX_SECONDS=10.0
# Backoff for judge calls the provider throttles or sheds (HTTP 429/503/529). The pause
# above is per-process and cannot bound the aggregate rate once a run is spread across
# workers; this reacts to the throttling each call actually sees. Attempts count the
# first try (1 disables retrying); the wait is exponential with full jitter, or the
# provider's Retry-After when it sends one, clamped to JUDGE_RETRY_MAX_SECONDS.
JUDGE_RETRY_MAX_ATTEMPTS=5
JUDGE_RETRY_BASE_SECONDS=1.0
JUDGE_RETRY_MAX_SECONDS=60.0
