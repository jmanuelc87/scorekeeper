{
  "manifest_version": 3,
  "name": "Scorekeeper Capture",
  "version": "0.1.0",
  "description": "Captura conversaciones de Copilot, Gemini, Claude y ChatGPT y las envía a Scorekeeper para evaluarlas.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capturar conversación para Scorekeeper",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://localhost:8001/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
