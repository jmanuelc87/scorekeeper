DATABASE_URL=postgresql+psycopg://scorekeeper:scorekeeper@localhost:5432/scorekeeper
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# LLM-as-a-judge (requires `uv sync --extra judges`)
JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_JUDGE_MODEL=claude-opus-4-8
OPENAI_JUDGE_MODEL=gpt-5.6-sol
JUDGE_MAX_TOKENS=8192
# Override the judge system prompt (leave blank to use the built-in Spanish default)
JUDGE_SYSTEM_PROMPT=
